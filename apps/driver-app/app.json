{
  "expo": {
    "name": "Laundry Bag Driver",
    "slug": "cleano-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cleano-driver",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "icon": "./assets/logo.jpg",
    "splash": {
      "image": "./assets/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#00af5f"
    },
    "ios": {
      "bundleIdentifier": "com.cleano.driver",
      "supportsTablet": false
    },
    "android": {
      "package": "com.cleano.driver",
      "adaptiveIcon": {
        "backgroundColor": "#00af5f"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-location",
      "expo-updates",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/new_order.wav",
            "./assets/sounds/order_update.wav"
          ]
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9f91156d-9d01-4151-ac7c-31ad246b5aae"
      }
    },
    "owner": "mohamed_hassan12"
  }
}
