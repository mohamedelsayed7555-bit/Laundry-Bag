{
  "expo": {
    "name": "CLEANO Driver",
    "slug": "cleano-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cleano-driver",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.cleano.driver",
      "supportsTablet": false
    },
    "android": {
      "package": "com.cleano.driver",
      "adaptiveIcon": {
        "backgroundColor": "#00af5f"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-location",
      "expo-print"
    ]
  }
}
