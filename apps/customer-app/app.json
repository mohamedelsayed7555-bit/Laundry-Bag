{
  "expo": {
    "name": "Laundry Bag",
    "slug": "cleano-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cleano",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "bundleIdentifier": "com.cleano.customer",
      "supportsTablet": false
    },
    "android": {
      "package": "com.cleano.customer",
      "adaptiveIcon": {
        "backgroundColor": "#00af5f"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDummyKeyForBuild"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-location",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/order-update.wav",
            "./assets/sounds/order-placed.wav"
          ]
        }
      ],
      "expo-av"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "178256af-c74c-4880-9722-8d30ba1e3e8b"
      }
    },
    "owner": "mohamed_hassan12"
  }
}
