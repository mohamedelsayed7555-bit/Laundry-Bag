{
  "expo": {
    "name": "Laundry Bag",
    "slug": "cleano-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cleano",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#e0e3e7"
    },
    "ios": {
      "bundleIdentifier": "com.cleano.customer",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "نستخدم موقعك لتحديد عنوان الاستلام والتسليم وتتبع طلبك.",
        "NSCameraUsageDescription": "نحتاج الكاميرا لالتقاط صورة لملفك الشخصي.",
        "NSPhotoLibraryUsageDescription": "نحتاج الوصول لصورك لاختيار صورة ملفك الشخصي.",
        "NSFaceIDUsageDescription": "نستخدم Face ID لتسجيل دخولك بسرعة وأمان."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.cleano.customer",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#7ECDE6"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-location",
      "expo-image-picker",
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-updates",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/order_update.wav",
            "./assets/sounds/order_placed.wav",
            "./assets/sounds/message.wav",
            "./assets/sounds/offer.wav"
          ]
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#e0e3e7"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.598928646055-b1n8maj84o9pq91stocdmlcsr740o1i8"
        }
      ],
      "expo-apple-authentication"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "278296f6-7a0c-4237-97ae-326fab30b0c6"
      }
    },
    "owner": "mohameddhassan12s-team",
    "updates": {
      "url": "https://u.expo.dev/278296f6-7a0c-4237-97ae-326fab30b0c6"
    }
  }
}
