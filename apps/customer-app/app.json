{
  "expo": {
    "name": "Laundry Bag",
    "slug": "cleano-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cleano",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "bundleIdentifier": "com.cleano.customer",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cleano.customer",
      "adaptiveIcon": {
        "backgroundColor": "#00af5f"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDummyKeyForBuild"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-location",
      "expo-image-picker",
      "@react-native-community/datetimepicker",
      "expo-localization",
      ["expo-notifications", {
        "sounds": ["./assets/sounds/order_update.wav", "./assets/sounds/order_placed.wav"]
      }]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "278296f6-7a0c-4237-97ae-326fab30b0c6"
      }
    },
    "owner": "mohameddhassan12s-team"
  }
}
